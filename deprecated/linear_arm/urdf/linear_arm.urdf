    <child link="B6"/>
    <origin xyz="0.0114584 -0.00226502 0.00499732" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.9" upper="2.9" effort="60" velocity="3.0"/>
  </joint>
