  <!-- R1: base_link 坐标系的 Z（竖直回转）（置信度 中） -->
  <joint name="R1" type="revolute">
    <parent link="B0"/>
    <child link="B1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9" upper="2.9" effort="60" velocity="3.0"/>
  </joint>
  <!-- R2: 由 EC-A6013 电机位置推断（置信度 低） -->
  <joint name="R2" type="revolute">
    <parent link="B1"/>
    <child link="B2"/>
    <origin xyz="-0.0449069 0.049415 -0.0786117" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.9" upper="2.9" effort="60" velocity="3.0"/>
  </joint>
  <!-- R3: 由 EC-A6013 电机位置推断（置信度 低） -->
  <joint name="R3" type="revolute">
    <parent link="B2"/>
    <child link="B3"/>
    <origin xyz="0.0092 0.082 -0.0017" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.9" upper="2.9" effort="60" velocity="3.0"/>
  </joint>
  <!-- R4: linear_4000 上端坐标系 + 模组轴线（丝杠自转）（置信度 高） -->
  <joint name="R4" type="revolute">
    <parent link="B3"/>
    <child link="B4"/>
    <origin xyz="0.0302019 0.020115 -0.0826883" rpy="0 0 0"/>
    <axis xyz="-0.0447603 -9.80212e-17 -0.998998"/>
    <limit lower="-2.9" upper="2.9" effort="60" velocity="3.0"/>
  </joint>
  <!-- L1: linear_4000 上/下端坐标系连线（螺母行程）（置信度 高） -->
  <joint name="L1" type="prismatic">
    <parent link="B4"/>
    <child link="B5"/>
    <origin xyz="-0.0129785 -2.84217e-17 -0.289664" rpy="0 0 0"/>
    <axis xyz="-0.0447603 -9.80212e-17 -0.998998"/>
    <limit lower="-0.05" upper="0.05" effort="200" velocity="0.5"/>
  </joint>
  <!-- R5: part4_肘部连接件位置推断（置信度 中） -->
