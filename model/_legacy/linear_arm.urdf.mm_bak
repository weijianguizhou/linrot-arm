  <!-- R1: 两刚体质心中点（置信度 中） -->
  <joint name="R1" type="revolute">
    <parent link="B0"/>
    <child link="B1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.9" upper="2.9" effort="60" velocity="3.0"/>
  </joint>
  <!-- R2: SolidWorks 配合轴线（置信度 高） -->
  <joint name="R2" type="revolute">
    <parent link="B1"/>
    <child link="B2"/>
    <origin xyz="-0.00506636 0.040197 -0.111131" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9" upper="2.9" effort="60" velocity="3.0"/>
