<!-- 由 model/templates/linear_arm.mjcf.tpl 渲染生成；修改模板后运行 model/tools_render_model.py。请勿手改本文件。 -->
<!-- 直线模组手臂 MuJoCo 模型。
     13 物理刚体 B0..B12；12 个物理树关节 + 3 个闭环 R6/R10/R12。
     腕部两根电缸的杆端鱼眼：每侧 1 个滑副体 + 3 个铰（Y-X-Z），共 8 个虚拟体、6 个鱼眼铰。
     6 个执行器：肩部 R1/R2/R3（旋转）+ 肘 L1、腕 L2/L3（直线电缸）；
     R4/R5/R7/R8/R9/R11 是四连杆/并联腕的被动关节，由闭环约束带动。
     闭环 + 鱼眼近零惯量需要 implicitfast 积分器；鱼眼铰加微小刚度/阻尼
     只是为了压住冗余自转（球铰绕杆轴的自由度），不影响任务运动。
     数值宏集中在 model/templates/linear_arm.mjcf.tpl 顶部。 -->

<!-- R2 只允许正转（0 位为竖直伸展）；L1 只能回缩，下限取标定实测的死点 −57 mm -->
<!-- 闭环等式约束的时间常数 (s)。默认 0.02 在重力负载下会松到 1.5 mm；
     1 ms 步长下取 0.002 可压到 0.05 mm，且 2.5 倍步长以内仍稳定。 -->
<!-- 执行器增益为占位值（等电机手册确认后替换）。位置伺服 + 速度阻尼，
     forcerange 与 URDF 里的 effort 占位值保持一致：旋转 60 N·m / 直线 200 N。 -->
<mujoco model="linear_arm">
  <compiler angle="radian" meshdir="../meshes" autolimits="true"/>
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="1400" offheight="1400"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
    <map znear="0.01" zfar="20"/>
  </visual>

  <default>
    <!-- 所有关节共用的阻尼与电枢；限位按 rev / slide 两个 class 复用。 -->
    <joint damping="0.05" armature="0.0"/>
    <!-- 模型只用于运动学/动力学，不参与碰撞；颜色由 material 统一。 -->
    <geom type="mesh" contype="0" conaffinity="0" group="1" material="body_grey"/>
    <default class="rev">
      <joint type="hinge" range="-2.9 2.9"/>
    </default>
    <default class="slide">
      <joint type="slide" range="-0.1 0.1"/>
    </default>
    <default class="gimbal">
      <joint type="hinge" range="-0.5 0.5" damping="0.01"
             stiffness="0.1" armature="1e-6"/>
    </default>
  </default>

  <asset>
    <material name="body_grey" rgba="0.7 0.7 0.72 1"/>
    <mesh name="B0_mesh" file="B0.stl"/>
    <mesh name="B1_mesh" file="B1.stl"/>
    <mesh name="B2_mesh" file="B2.stl"/>
    <mesh name="B3_mesh" file="B3.stl"/>
    <mesh name="B4_mesh" file="B4.stl"/>
    <mesh name="B5_mesh" file="B5.stl"/>
    <mesh name="B6_mesh" file="B6.stl"/>
    <mesh name="B7_mesh" file="B7.stl"/>
    <mesh name="B8_mesh" file="B8.stl"/>
    <mesh name="B9_mesh" file="B9.stl"/>
    <mesh name="B10_mesh" file="B10.stl"/>
    <mesh name="B11_mesh" file="B11.stl"/>
    <mesh name="B12_mesh" file="B12.stl"/>
  </asset>

  <worldbody>
    <!-- B0：2 个零件 -->
    <body name="B0">
      <inertial pos="0.00199376 0.0149344 -9.28886e-05" mass="0.640000" fullinertia="5.054564e-04 4.618816e-04 5.076499e-04 -6.805731e-06 8.319443e-07 3.106859e-06"/>
      <geom name="B0_geom" mesh="B0_mesh"/>

      <!-- B1：4 个零件 -->
      <body name="B1">
        <joint name="R1" class="rev" axis="0.130526 0.991445 0"/>
        <inertial pos="0.0212886 0.0938392 -0.0209183" mass="0.938862" fullinertia="2.193144e-03 2.213321e-03 8.211174e-04 2.366851e-05 3.952843e-04 -1.919700e-05"/>
        <geom name="B1_geom" mesh="B1_mesh"/>

        <!-- B2：3 个零件 -->
        <body name="B2" pos="-0.000163 0.098357 0">
          <joint name="R2" class="rev" axis="0.991445 -0.130526 0" range="0.0 2.9"
                 solreflimit="0.002 1"/>
          <inertial pos="0.00554114 -0.0004987 -0.0936251" mass="0.536485" fullinertia="4.697595e-04 4.622306e-04 2.181586e-04 -1.324272e-06 -1.110579e-05 4.049904e-06"/>
          <geom name="B2_geom" mesh="B2_mesh"/>

          <!-- B3：7 个零件 -->
          <body name="B3" pos="0.007431 -0.000978 -0.095902">
            <joint name="R3" class="rev" axis="0 0 1"/>
            <inertial pos="0.0410789 -9.3314e-08 -0.16692" mass="0.693504" fullinertia="7.248301e-03 7.466091e-03 4.479889e-04 -2.889562e-10 -1.417894e-04 -2.680659e-09"/>
            <geom name="B3_geom" mesh="B3_mesh"/>

            <!-- B4：2 个零件 -->
            <body name="B4" pos="-1.4e-07 -3e-08 -0.0710983">
              <joint name="R4" class="rev" axis="0 1 0"/>
              <inertial pos="-0.00339789 5.18373e-06 -0.124467" mass="1.655451" fullinertia="4.619909e-03 4.623260e-03 5.253852e-04 -4.467168e-08 -1.107919e-04 6.394150e-07"/>
              <geom name="B4_geom" mesh="B4_mesh"/>

              <!-- B5：5 个零件 -->
              <body name="B5" pos="-0.00617502 -6.68732e-10 -0.224006">
                <joint name="L1" class="slide" axis="-0.0275558 -2.98419e-09 -0.99962" range="-0.057 0.0"
                       solreflimit="0.002 1"/>
                <inertial pos="-0.0010802 1.14609e-08 -0.0369863" mass="0.024928" fullinertia="9.618326e-06 8.550634e-06 2.400692e-06 -8.728906e-09 -1.948029e-07 -2.033429e-09"/>
                <geom name="B5_geom" mesh="B5_mesh"/>

                <!-- B6：4 个零件 -->
                <body name="B6" pos="-0.00132494 -1.43486e-10 -0.0480638">
                  <joint name="R5" class="rev" axis="0 1 0"/>
                  <inertial pos="0.0477517 -3.52953e-08 -0.0945253" mass="0.660446" fullinertia="4.068980e-03 4.276690e-03 4.055850e-04 -1.058340e-10 -3.342091e-05 -3.422278e-09"/>
                  <geom name="B6_geom" mesh="B6_mesh"/>

                  <!-- B7：1 个零件 -->
                  <body name="B7" pos="0.057282 0 -0.24743">
                    <joint name="R7" class="rev" axis="-1 0 0"/>
                    <inertial pos="0.00143629 2.84217e-17 3.027e-11" mass="0.013479" fullinertia="6.213311e-07 2.347898e-06 2.797525e-06 -1.950193e-22 -4.422111e-14 -3.493028e-13"/>
                    <geom name="B7_geom" mesh="B7_mesh"/>

                  </body>

                  <!-- B8：1 个零件 -->
                  <body name="B8" pos="0.0205 0.036 -0.08243">
                    <joint name="R8" class="rev" axis="0 1 0"/>
                    <inertial pos="-0.00570782 1.7684e-05 -0.0706078" mass="0.540000" fullinertia="7.211051e-05 7.256674e-05 1.079676e-05 1.062342e-08 -5.023540e-06 2.329981e-08"/>
                    <geom name="B8_geom" mesh="B8_mesh"/>

                    <!-- B10：1 个零件；杆端鱼眼用 3 铰（Y-X-Z）近似 -->
                    <body name="L2g_slide" pos="-0.00958239 0 -0.119617">
                      <joint name="L2" class="slide" axis="-0.0798533 0 -0.996807"/>
                      <inertial pos="0 0 0" mass="1e-6" diaginertia="1e-9 1e-9 1e-9"/>

                      <body name="L2g_gy" pos="0 0 0">
                        <joint name="L2g_gy" class="gimbal" axis="0 1 0"/>
                        <inertial pos="0 0 0" mass="1e-6" diaginertia="1e-9 1e-9 1e-9"/>

                        <body name="L2g_gx" pos="0 0 0">
                          <joint name="L2g_gx" class="gimbal" axis="1 0 0"/>
                          <inertial pos="0 0 0" mass="1e-6" diaginertia="1e-9 1e-9 1e-9"/>

                          <body name="L2g_gz" pos="0 0 0">
                            <joint name="L2g_gz" class="gimbal" axis="0 0 1"/>
                            <inertial pos="0 0 0" mass="1e-6" diaginertia="1e-9 1e-9 1e-9"/>

                            <body name="B10" pos="0 0 0">
                              <inertial pos="-0.000373276 8.22244e-09 -0.00449624" mass="0.009826" fullinertia="1.043468e-05 1.056540e-05 3.278400e-07 -3.400169e-13 -8.095001e-07 -2.007156e-12"/>
                              <geom name="B10_geom" mesh="B10_mesh"/>

                              <!-- B12：1 个零件 -->
                              <body name="B12" pos="-0.00363561 0 -0.0453832">
                                <joint name="R11" class="rev" axis="0 1 0"/>
                                <inertial pos="0.0267515 -0.0359999 -0.0129595" mass="0.099639" fullinertia="4.144548e-05 5.291078e-05 5.460237e-05 2.060831e-10 -1.713458e-05 -1.620054e-10"/>
                                <geom name="B12_geom" mesh="B12_mesh"/>
                              </body>
                            </body>
                          </body>
                        </body>
                      </body>
                    </body>
                  </body>

                  <!-- B9：1 个零件 -->
                  <body name="B9" pos="0.0205 -0.036 -0.08243">
                    <joint name="R9" class="rev" axis="0 1 0"/>
                    <inertial pos="-0.00560549 -1.7684e-05 -0.070616" mass="0.540000" fullinertia="7.213567e-05 7.256674e-05 1.077161e-05 6.778689e-09 -4.867544e-06 -2.469387e-08"/>
                    <geom name="B9_geom" mesh="B9_mesh"/>

                    <!-- B11：1 个零件；杆端鱼眼用 3 铰（Y-X-Z）近似 -->
                    <body name="L3g_slide" pos="-0.00958239 0 -0.119617">
                      <joint name="L3" class="slide" axis="-0.0798533 0 -0.996807"/>
                      <inertial pos="0 0 0" mass="1e-6" diaginertia="1e-9 1e-9 1e-9"/>

                      <body name="L3g_gy" pos="0 0 0">
                        <joint name="L3g_gy" class="gimbal" axis="0 1 0"/>
                        <inertial pos="0 0 0" mass="1e-6" diaginertia="1e-9 1e-9 1e-9"/>

                        <body name="L3g_gx" pos="0 0 0">
                          <joint name="L3g_gx" class="gimbal" axis="1 0 0"/>
                          <inertial pos="0 0 0" mass="1e-6" diaginertia="1e-9 1e-9 1e-9"/>

                          <body name="L3g_gz" pos="0 0 0">
                            <joint name="L3g_gz" class="gimbal" axis="0 0 1"/>
                            <inertial pos="0 0 0" mass="1e-6" diaginertia="1e-9 1e-9 1e-9"/>

                            <body name="B11" pos="0 0 0">
                              <inertial pos="-0.000373276 8.22244e-09 -0.00449624" mass="0.009826" fullinertia="1.043468e-05 1.056540e-05 3.278400e-07 -3.400169e-13 -8.095001e-07 -2.007156e-12"/>
                              <geom name="B11_geom" mesh="B11_mesh"/>
                            </body>
                          </body>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- 6 个位置执行器：ctrl 为关节目标（旋转 rad / 直线 m），
       kv 提供速度阻尼；被动关节不配执行器，靠闭环约束随动。 -->
  <actuator>
    <position name="act_R1" joint="R1" kp="800" kv="20"
              ctrlrange="-2.9 2.9"
              forcerange="-60 60"/>
    <position name="act_R2" joint="R2" kp="800" kv="20"
              ctrlrange="0.0 2.9"
              forcerange="-60 60"/>
    <position name="act_R3" joint="R3" kp="800" kv="20"
              ctrlrange="-2.9 2.9"
              forcerange="-60 60"/>
    <position name="act_L1" joint="L1" kp="20000" kv="200"
              ctrlrange="-0.057 0.0"
              forcerange="-200 200"/>
    <position name="act_L2" joint="L2" kp="20000" kv="200"
              ctrlrange="-0.1 0.1"
              forcerange="-200 200"/>
    <position name="act_L3" joint="L3" kp="20000" kv="200"
              ctrlrange="-0.1 0.1"
              forcerange="-200 200"/>
  </actuator>

  <!-- 闭环：URDF 树中切断的 R6 / R10 / R12，anchor 为 body1 局部坐标 (m)。 -->
  <equality>
    <!-- R6: B3 -> B6 -->
    <connect name="loop_R6" body1="B3" body2="B6" anchor="0.013 0 -0.318598" solref="0.002 1"/>
    <!-- R10: B7 -> B12 -->
    <connect name="loop_R10" body1="B7" body2="B12" anchor="-0.01 0 0" solref="0.002 1"/>
    <!-- R12: B11 -> B12 -->
    <connect name="loop_R12" body1="B11" body2="B12" anchor="-0.003636 0 -0.045383" solref="0.002 1"/>
  </equality>
</mujoco>
