  <!-- R1: SolidWorks 同心配合轴线 (肩部第1轴) -->
  <joint name="R1" type="revolute">
    <parent link="B0" />
    <child link="B1" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.9" upper="2.9" effort="60" velocity="3.0" />
  </joint>
  <!-- R2: SolidWorks 同心配合轴线 (肩部第2轴) -->
  <joint name="R2" type="revolute">
    <parent link="B1" />
    <child link="B2" />
    <origin xyz="0 0.05875 -0.104612" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-2.9" upper="2.9" effort="60" velocity="3.0" />
  </joint>
  <!-- R3: SolidWorks 同心529/530 (大臂电缸上支点) -->
  <joint name="R3" type="revolute">
    <parent link="B2" />
    <child link="B3" />
    <origin xyz="0 0 -0.0623883" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.9" upper="2.9" effort="60" velocity="3.0" />
  </joint>
  <!-- L1: SolidWorks 同心553 (大臂电缸直线移动副) -->
  <joint name="L1" type="prismatic">
    <parent link="B3" />
    <child link="B4" />
    <origin xyz="-0.00617502 -6.68732e-10 -0.224006" rpy="0 0 0" />
    <axis xyz="-0.0275558 -2.98419e-09 -0.99962" />
    <limit lower="-0.1" upper="0.1" effort="200" velocity="0.5" />
  </joint>
  <!-- R4: SolidWorks 同心552/554 (大臂电缸下支点) -->
  <joint name="R4" type="revolute">
    <parent link="B4" />
    <child link="B5" />
    <origin xyz="-0.00132494 -1.43486e-10 -0.0480638" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.9" upper="2.9" effort="60" velocity="3.0" />
  </joint>
  <!-- R6: SolidWorks 同心34/417 (腕部十字轴第1轴) -->
