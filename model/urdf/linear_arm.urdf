<?xml version="1.0" encoding="utf-8"?>
<!-- 直线模组手臂 v2（精确对齐 手臂动力学模型.png 竖直标准零位 q=0）：
     * 12 刚体（B0..B11），14 关节（11 树关节 + 3 闭环关节 R5/R9/R11）
