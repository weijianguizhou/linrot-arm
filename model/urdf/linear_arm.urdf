<?xml version="1.0" encoding="utf-8"?>
<!-- 由 model/templates/linear_arm.urdf.tpl 渲染生成；修改模板后运行 model/tools_render_model.py。请勿手改本文件。 -->
<!-- 直线模组手臂 URDF 模型。
     13 刚体 B0..B12；12 树关节 + 3 闭环关节 R6/R10/R12。
     闭环关节不在 URDF 树中，位置见 loops.yaml 与 MJCF 的 equality。
     数值宏集中在 model/templates/linear_arm.urdf.tpl 顶部。 -->

<robot name="linear_arm">
  <!-- 统一颜色：RViz / urdfdom 会读取此顶层 material。 -->
  <material name="body_grey">
    <color rgba="0.7 0.7 0.72 1"/>
  </material>

  <link name="base_link"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="B0"/>
  </joint>

  <!-- B0：2 个零件 -->
  <link name="B0">
    <visual>
      <geometry><mesh filename="../meshes/B0.stl"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <geometry><mesh filename="../meshes/B0.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.00199376 0.0149344 -9.28886e-05"/>
      <mass value="0.640000"/>
      <inertia ixx="5.054564e-04" ixy="-6.805731e-06" ixz="8.319443e-07" iyy="4.618816e-04" iyz="3.106859e-06" izz="5.076499e-04"/>
    </inertial>
  </link>

  <!-- B1：4 个零件 -->
